+_CONNECTION_KWARGS = {
+    # After an ElastiCache failover (e.g. a service-update rollout) the old primary stays up as a
+    # replica, and pooled sockets still connected to it get READONLY on every write until the node
+    # is restarted (minutes). Retrying on ReadOnlyError makes redis-py disconnect the socket and
+    # reconnect, which re-resolves the primary endpoint DNS and reaches the new primary. The Lua
+    # scripts are safe to retry: a replica rejects the first write, before any state is changed.
+    "retry_on_error": [ReadOnlyError],
+    # Bound connect/read so a dead or half-open primary fails fast instead of hanging for the OS
+    # TCP timeout; health checks drop idle sockets that died silently.
+    "socket_connect_timeout": 5,
+    "socket_timeout": 10,
+    "socket_keepalive": True,
+    "health_check_interval": 30,
+}
+
+
+def _connection_kwargs(redis_class):
+    kwargs = dict(_CONNECTION_KWARGS)
+    # redis-py 8.0.0 changed default retries from 3 to 10, causing content app request timeouts
+    # when Redis is unreachable. This reverts only retries; backoff base/cap are kept at 8.0.0
+    # defaults. The asyncio client needs the asyncio Retry: the sync one never awaits the
+    # command, so it silently disables retries.
+    if redis_module.VERSION >= (8,):
+        from redis.backoff import ExponentialWithJitterBackoff
+
+        if issubclass(redis_class, aRedis):
+            from redis.asyncio.retry import Retry
+        else:
+            from redis.retry import Retry
 
-    _CONNECTION_KWARGS["retry"] = Retry(
