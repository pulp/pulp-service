From ae0e1b9c3a641954ea5a08db189def32de871886 Mon Sep 17 00:00:00 2001
From: Yasen <yasen@trahnov.eu>
Date: Thu, 24 Sep 2026 11:52:33 +0200
Subject: [PATCH] Fix worker crash on RPM changelog entries with invalid UTF-8

createrepo_c's changelog decoding can crash the whole worker process with
a SIGSEGV when a changelog entry contains bytes that aren't valid UTF-8
(seen on packages built with old, non-UTF-8-locale rpmbuild toolchains,
e.g. Latin-1-encoded author names). Read changelogs via rpm_rs instead,
which already handles this leniently (replacing invalid bytes with
U+FFFD) rather than crashing.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
---
 pulp_rpm/app/models/package.py      |  9 +++++++--
 pulp_rpm/app/serializers/package.py | 23 +++++++++++++++++------
 pulp_rpm/app/shared_utils.py        | 14 ++++++++++++--
 pulp_rpm/app/tasks/signing.py       |  7 +++++--
 4 files changed, 41 insertions(+), 12 deletions(-)

diff --git a/pulp_rpm/app/models/package.py b/pulp_rpm/app/models/package.py
index b025d3557..9f85e3382 100644
--- a/pulp_rpm/app/models/package.py
+++ b/pulp_rpm/app/models/package.py
@@ -284,7 +284,9 @@ class Package(Content):
         readonly = ["evr"]
 
     @classmethod
-    def createrepo_to_dict(cls, package, tuple_cache=None, string_cache=None, signing_keys=None):
+    def createrepo_to_dict(
+        cls, package, tuple_cache=None, string_cache=None, signing_keys=None, changelogs=None
+    ):
         """
         Convert createrepo_c package object to dict for instantiating Package object.
 
@@ -296,12 +298,15 @@ class Package(Content):
             string_cache(dict): A dictionary used to intern strings - helpful to avoid
                 duplicate strings in memory by converting them into shallow refcounted "copies"
                 of existing strings
+            changelogs(list): Pre-read (name, time, text) changelog tuples, used instead of
+                ``package.changelogs`` when given
 
         Returns:
             dict: all data for RPM/SRPM content creation
 
         """
-        changelogs = package.changelogs
+        if changelogs is None:
+            changelogs = package.changelogs
 
         # make sure the changelogs are sorted by date
         changelogs.sort(key=lambda t: t[1])
diff --git a/pulp_rpm/app/serializers/package.py b/pulp_rpm/app/serializers/package.py
index ba3b52021..8a88cebf2 100644
--- a/pulp_rpm/app/serializers/package.py
