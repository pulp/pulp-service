+# Postgres caps ``application_name`` at NAMEDATALEN - 1 bytes.
+_APPLICATION_NAME_MAX_BYTES = 63
+
+# The current process's role (``api`` / ``content`` / ``worker``), recorded the
+# first time a domain-entry point tags a connection. It is effectively constant
+# per process, so a plain module global is safe and -- unlike a ContextVar -- it
+# is visible to the ``connection_created`` handler no matter which thread opens
+# the connection (e.g. a read replica opened lazily inside ``sync_to_async``).
+_db_application_process_type = None
+
+
+def _db_application_name_value(process_type, domain):
+    """
+    Build the ``application_name`` value for a process type and domain.
+
+    Returns ``pulp-<process_type>:<domain.name>`` truncated to 63 bytes
+    (the Postgres ``application_name`` cap), dropping any partial trailing
+    UTF-8 byte so the result is always valid UTF-8. Pure: performs no I/O.
+    """
+    value = f"pulp-{process_type}:{domain.name}"
+    encoded = value.encode("utf-8")
+    if len(encoded) <= _APPLICATION_NAME_MAX_BYTES:
+        return value
+    return encoded[:_APPLICATION_NAME_MAX_BYTES].decode("utf-8", "ignore")
+
+
+def _set_application_name_on(conn, value):
+    """Issue ``SET application_name`` on an open connection, swallowing errors."""
+    with suppress(Exception):
+        with conn.cursor() as cursor:
+            cursor.execute("SET application_name = %s", [value])
+
+
+def _tag_connection_with_domain(sender, connection, **kwargs):
+    """
+    ``connection_created`` handler that tags a freshly opened connection.
+
+    This is what labels the read replica: with a replica configured, reads are
+    routed to a separate ``replica`` connection that Django opens lazily on its
+    first read -- after the domain is known -- so the entry-point ``SET`` on the
+    default connection would otherwise miss it.
+
+    The domain is read directly from the context variable (never ``get_domain()``,
+    which would fall through to ``get_default_domain()`` and issue a query -- or
+    create the default Domain -- while a connection is mid-setup). If no domain is
+    active yet (e.g. the default connection opened for pre-domain auth), the entry
+    point tags it later instead. The process type is the per-process global set by
+    the entry points.
+    """
+    domain = _current_domain.get()
+    if _db_application_process_type is None or domain is None:
+        return
+    value = _db_application_name_value(_db_application_process_type, domain)
+    _set_application_name_on(connection, value)
+
+
+connection_created.connect(_tag_connection_with_domain, dispatch_uid="pulpcore_db_application_name")
+
+
+def set_db_application_name(process_type, domain=None):
+    """
+    Tag the current DB connections' ``application_name`` with the current domain.
+
+    Labels connections as ``pulp-<process_type>:<domain.name>`` so RDS
+    Performance Insights can break down ``db.load`` per domain via its Top
+    Applications dimension. Called at the points where the domain becomes known
+    (API middleware, content auth, worker task context).
+
+    Every currently-open connection is tagged -- the default connection, and the
+    read replica if an earlier read already opened it. Connections opened later
+    (notably the replica on its first read) are tagged by the
+    ``connection_created`` handler above. Unopened connections are skipped so
+    this never force-opens an idle replica socket.
+
+    Any error issuing the ``SET`` is suppressed so a missing/unavailable DB
+    (management commands, migrations, tests) can never break the caller.
+    """
+    global _db_application_process_type
+    _db_application_process_type = process_type
+    domain = domain or get_domain()
+    value = _db_application_name_value(process_type, domain)
+    for conn in connections.all():
+        if conn.connection is not None:
+            _set_application_name_on(conn, value)
+
