+    @classmethod
+    async def _retry_content_artifact_query(cls, query):
+        """
+        Await a ``ContentArtifact`` queryset call (e.g. ``.aget()``/``.aexists()``),
+        retrying once on a fresh connection if the read replica connection was
+        killed mid-query, e.g. by a standby recovery conflict.
+
+        ``MultipleObjectsReturned``/``ObjectDoesNotExist`` are left to the caller.
+        """
+        try:
+            return await query()
+        except (InterfaceError, DatabaseError):
+            cls._reset_db_connection()
+            return await query()
