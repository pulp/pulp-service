+from pulpcore.app.util import get_domain
 from pulpcore.metrics import artifacts_size_counter
 from pulpcore.responses import ArtifactResponse

@@ -444,6 +445,19 @@ class AsyncContentCache(AsyncCache):
         if lm_epoch is not None and lm_epoch <= ims_epoch:
             raise HTTPNotModified(headers=headers)

+    @staticmethod
+    def _parse_max_age(response):
+        """Parse max-age value from response Cache-Control header."""
+        cache_control = response.headers.get("Cache-Control", "")
+        for directive in cache_control.split(","):
+            directive = directive.strip().lower()
+            if directive.startswith("max-age="):
+                try:
+                    return int(directive[8:])
+                except (ValueError, IndexError):
+                    return None
+        return None
+
     def get_request_from_args(self, args):
         """Finds the request object from list of args"""
         for arg in args:
@@ -491,6 +505,11 @@ class AsyncContentCache(AsyncCache):

         entry = {"headers": dict(response.headers), "status": response.status}

+        domain = get_domain()
+        max_age = self._parse_max_age(response)
+        if not domain.redirect_to_object_storage and max_age is not None and max_age > 0:
+            expires = max_age
+
         if expires is not None:
             # Redis TTL is not sufficient: https://github.com/pulp/pulpcore/issues/4845
             entry["expires"] = expires + time.time()
