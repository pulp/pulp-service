+        versions_by_domain = {domain: [domain], other_domain: [other_domain]}
+
+        page, total = scatter_gather(
+            versions_by_domain, build_queryset, order_by="name", limit=2, offset=0
+        )
+
+        assert total == 4
+        assert [r.name for r in page] == ["a1", "a2"]
