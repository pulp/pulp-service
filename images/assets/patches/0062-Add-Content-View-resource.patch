+        self._make_repos(domain, ["a1", "a2", "a3"])
+        self._make_repos(other_domain, ["b1"])
+
+        def build_queryset(versions):
+            (current_domain,) = versions
+            return Repository.objects.filter(pulp_domain=current_domain).order_by("name")
