#!/usr/bin/env python3
"""Independent check that each chief's live respond_to allowlist matches the rule.

On OpenShift a chief's allowlist is the respond_to list in its own agent.yaml, deployed
from the public pulp-service repo (an approver merges the PR). This check reads those
LIVE allowlists from a fresh read-only clone of pulp-service, computes the intended
allowlist for each chief from the reporting-line rule in config/platform.yaml
(rh/cluster) plus the agents the roster says that chief manages, and prints one FAIL
line per drift:
  - a chief whose live allowlist differs from the rule (missing or extra keys),
  - a chief agent.yaml missing or not using respond_to: allowlist.
A managed agent is part of the intended set, so it is covered by the same missing/extra
comparison; there is no separate rule that could contradict it.

The rule logic (members_for) is baked into this image, not loaded from any clone, so
gm-rh (which can push to rh/cluster) cannot run code inside the auditor. Both sides of the
comparison are read from fresh clones taken here, not from the pod's /state/repos clones:
those clones are writable by the gm-rh session, and a git pull --ff-only keeps a session's
uncommitted local edits, so reading config/platform.yaml or roster.json from them would
let a compromised session tamper with the data the check compares and make it pass.
config/platform.yaml and roster.json are read as data; an unapproved change to the former
is caught separately by audit-approvals. The live allowlists come from pulp-service, which
gm-rh cannot push to, so the two sides of the comparison are both approver gated.

The repo URLs are pinned constants, not read from the environment or argv, so a
compromised session cannot point the check at data it controls and make it pass. The pure
functions (members_for, managed_agents, live_allowlist) take a directory or config so the
tests in render/tests/test_reach_check.py exercise them against fixtures offline.

Prints "reach-check: ok" and exits 0 when everything lines up, 1 on any FAIL, 2 when
the check itself could not run (clone, config, parse).
"""
import json
import os
import shutil
import subprocess
import sys
import tempfile

import yaml

# Pinned. Not overridable from the environment or argv: the running agent must not be able
# to substitute its own repos, and a fresh clone cannot carry a session's local edits.
CLUSTER_URL = "https://gitea.bouterse.casa/rh/cluster.git"
AGENTS_URL = "https://gitea.bouterse.casa/rh/agents.git"
PULP_SERVICE_REPO = "https://github.com/pulp/pulp-service.git"

GIT_TIMEOUT = 120


def die(msg):
    print(f"reach-check: {msg}", file=sys.stderr)
    sys.exit(2)


def norm(k):
    """Normalise a key for comparison. Raises TypeError on a non-string, so a malformed
    principal or role key in config/platform.yaml surfaces as a setup failure (exit 2)
    through the callers' handlers, not an uncaught AttributeError (exit 1)."""
    if not isinstance(k, str):
        raise TypeError(f"expected a string key, got {type(k).__name__}")
    return k.strip().lower()


def members_for(chief_id, cfg):
    """Intended keys a chief hears from the reporting-line rule: principals, owner,
    staff roles, named extras. Baked here, not imported from any clone, so no pushable
    code runs. Raises KeyError/TypeError on a malformed config, which the caller turns
    into a setup failure (exit 2)."""
    chief = cfg["chiefs"][chief_id]
    roles = cfg.get("roles", {})
    keys = set()
    for p in cfg.get("principals", []):
        keys.add(norm(p["key"]))
    owner = chief.get("owner")
    if owner:
        keys.add(norm(roles[owner]["key"]))
    for s in chief.get("staff", []) or []:
        keys.add(norm(roles[s]["key"]))
    for e in chief.get("extra", []) or []:
        keys.add(norm(e["key"]))
    return keys


def live_allowlist(agents_dir, chief_id):
    """(error_or_None, respond_to, set(keys)) from the deployed agent.yaml."""
    path = os.path.join(agents_dir, chief_id, "agent.yaml")
    try:
        with open(path) as f:
            d = yaml.safe_load(f)
    except FileNotFoundError:
        return "agent.yaml not found in pulp-service", None, set()
    except (OSError, yaml.YAMLError) as e:
        return f"agent.yaml does not parse ({e})", None, set()
    if not isinstance(d, dict):
        return "agent.yaml is not a mapping", None, set()
    allow = d.get("allowlist") or []
    # A list of pubkey strings and nothing else: a mapping (whose keys could look
    # right) or a stray non-string entry is a malformed allowlist, not a pass.
    if not isinstance(allow, list) or not all(isinstance(k, str) for k in allow):
        return "allowlist is not a list of pubkey strings", d.get("respond_to"), set()
    keys = {norm(k) for k in allow}
    return None, d.get("respond_to"), keys


def managed_agents(agents_repo):
    """Roster entries managed by a chief: (managing_role, slug, key). The roster is an
    object keyed by slug and lives at staff/roster.json in the agents repo. Returns [] when
    there is no roster file. A roster that exists but does not parse, or is not an object,
    is a setup failure (exit 2): silently returning [] would drop every managed agent from
    the intended set and mislabel the deployed ones as 'extra'. Entries without managed_by
    are not managed agents; a managed entry without a usable pubkey is a setup failure."""
    path = os.path.join(agents_repo, "staff", "roster.json")
    try:
        with open(path) as f:
            roster = json.load(f)
    except FileNotFoundError:
        return []
    except (OSError, json.JSONDecodeError) as e:
        die(f"staff/roster.json does not parse ({e})")
    if not isinstance(roster, dict):
        die("staff/roster.json is not an object keyed by slug")
    out = []
    for slug, e in roster.items():
        if not isinstance(e, dict):
            die(f"staff/roster.json entry {slug!r} is not an object")
        mb = e.get("managed_by")
        if mb in (None, ""):
            continue  # not a managed agent
        pk = e.get("pubkey")
        # A managed agent we cannot name a key for would silently drop out of the
        # intended set, so an allowlist missing it would read as clean: refuse instead.
        if not isinstance(mb, str) or not isinstance(pk, str) or not pk:
            die(f"staff/roster.json entry {slug!r} is managed but has no usable managed_by and pubkey")
        out.append((norm(mb), slug, norm(pk)))
    return out


def git(args, **kw):
    """Run a git command with a timeout. Returns the CompletedProcess; raises
    TimeoutExpired or CalledProcessError to the caller."""
    return subprocess.run(["git", *args], timeout=GIT_TIMEOUT,
                          capture_output=True, text=True, **kw)


def clone_fresh(url, parent, name):
    """Shallow read-only clone of url into parent/name, or a setup failure. A fresh clone
    cannot carry a session's uncommitted local edits, unlike a pull into /state/repos. The
    pod's global credential helper supplies the Gitea token; never a token in the URL."""
    dest = os.path.join(parent, name)
    try:
        git(["clone", "--quiet", "--depth", "1", url, dest], check=True)
    except subprocess.TimeoutExpired:
        die(f"cloning {name} timed out; not running on stale data")
    except subprocess.CalledProcessError as e:
        die(f"cannot clone {name} ({(e.stderr or '').strip()[:200]})")
    if not os.path.isdir(os.path.join(dest, ".git")):
        die(f"clone of {name} produced no working tree")
    return dest


def checkout_pulp_service(parent):
    """Return the agents dir inside a read-only clone of pulp-service from the pinned
    public URL, shallow and sparse to the agent definitions only."""
    dest = os.path.join(parent, "ps")
    try:
        git(["clone", "--quiet", "--depth", "1", "--filter=blob:none", "--sparse",
             PULP_SERVICE_REPO, dest], check=True)
        git(["-C", dest, "sparse-checkout", "set", ".buzz/agents"], check=True)
    except subprocess.TimeoutExpired:
        die("cloning pulp-service timed out")
    except subprocess.CalledProcessError as e:
        die(f"cannot clone pulp-service ({(e.stderr or '').strip()[:200]})")
    adir = os.path.join(dest, ".buzz", "agents")
    if not os.path.isdir(adir):
        die("pulp-service clone has no .buzz/agents")
    return adir


def main():
    tmp = tempfile.mkdtemp()
    fails = []

    def fail(msg):
        fails.append(msg)
        print(f"FAIL {msg}")

    try:
        cluster_dir = clone_fresh(CLUSTER_URL, tmp, "cluster")
        agents_dir_repo = clone_fresh(AGENTS_URL, tmp, "agents")

        cfg_path = os.path.join(cluster_dir, "config", "platform.yaml")
        try:
            with open(cfg_path) as f:
                cfg = yaml.safe_load(f)
        except (OSError, yaml.YAMLError) as e:
            die(f"cannot read config/platform.yaml ({e})")
        if not isinstance(cfg, dict) or not isinstance(cfg.get("chiefs"), dict):
            die("config/platform.yaml has no chiefs mapping")

        managed = managed_agents(agents_dir_repo)
        agents_dir = checkout_pulp_service(tmp)

        for chief_id in cfg["chiefs"]:
            try:
                intended = members_for(chief_id, cfg)
            except (KeyError, TypeError) as e:
                die(f"config/platform.yaml is malformed for {chief_id} ({e})")
            # A managed agent is part of the chief's intended allowlist (reporting-line
            # rule 4), so fold it in here and let the one missing/extra comparison cover
            # it. members_for and this agree, so no key is both "missing" and "extra".
            for role, _slug, key in managed:
                if role == chief_id:
                    intended.add(key)

            err, respond_to, live = live_allowlist(agents_dir, chief_id)
            if err:
                fail(f"{chief_id}: {err}")
                continue
            if respond_to != "allowlist":
                fail(f"{chief_id}: agent.yaml respond_to is {respond_to!r}, not 'allowlist'")
                continue
            missing = intended - live
            extra = live - intended
            if missing:
                fail(f"{chief_id}: live allowlist is missing {sorted(k[:8] for k in missing)} (rule in config/platform.yaml)")
            if extra:
                fail(f"{chief_id}: live allowlist has extra {sorted(k[:8] for k in extra)} not in the rule")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)

    if fails:
        print(f"reach-check: {len(fails)} problem(s)")
        return 1
    print("reach-check: ok")
    return 0


if __name__ == "__main__":
    sys.exit(main())
