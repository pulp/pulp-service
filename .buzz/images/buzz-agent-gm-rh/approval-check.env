# Single source of truth for the approval-check tooling, so the two consumers can
# never drift: approval-check (run by gm-approvals for the daily status, determinism
# item 2) and gm-pending (boot resume and the heartbeat, determinism item 7) both
# read these. Assembled to /opt/agent/approval-check.env, root owned and read only,
# so the running agent cannot edit the approver list. Shell sourceable (KEY=value).
#
# A change to any value here needs an approver's yes, same as any other principal change.
APPROVER_KEYS=763c87084f3b5afb6c422411601d135c57545bdc14a8d46499c1130c1b5735c1,e5abab3a573180128c205fd9b7764511c81ee641b8594e6c7acbb2f90631a0a4
GM_KEY=6c6d64a0b90c4f1dbce52c14cf05f26cc4f2ab6233576c6a23cac7e157dbde93
APPROVAL_CHANNELS=19bd0a73-ae3b-4007-8e44-a9e43f7f3710,ab32a1ee-7b21-4187-a556-de579d1c6a7a
# COS_KEY: cos-rh's hex pubkey, so its "For the GM:" asks show up in gm-pending. Confirmed
# against the chief allowlist (cos-rh) and its relay profile. Set by Brian's Claude's yes,
# event 4392b048.
COS_KEY=6a14bf7b3d7259f77e5b40a4817a084b11002f54e585eda431c4befa5d150c0d
# CHANNEL_NAMES: labels for APPROVAL_CHANNELS in order, so gm-pending (the canonical
# file, which reads CHANNEL_NAMES) prints #gm and #staff instead of channel id prefixes.
# Set by Brian's Claude's yes, event d4d70a21.
CHANNEL_NAMES=#gm,#staff
