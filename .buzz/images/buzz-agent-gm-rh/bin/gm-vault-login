#!/usr/bin/env bash
# gm-vault-login: log in to vault.devshift.net with the pod's AppRole and write ONLY the
# resulting token to the vault CLI's token helper file ($HOME/.vault-token), so the
# session can run `vault ...` without ever reading role_id/secret_id itself. secret-guard
# blocks a session that reads the mount directly; this tool reads the ids here and hands
# them to vault, the same way gitea-api reads the Gitea token. The charter rule it serves:
# read a secret file only to hand it to the tool that needs it. This file is that tool.
#
#   gm-vault-login
#
# Run at boot by gm-entrypoint, and re-run any time from the session to refresh the token
# (the pulp-buzz-agents-gm-rh AppRole token TTL is 30 min; the ids stay out of reach).
# On success the token is in place for, e.g.:
#   vault token lookup
#   vault kv metadata get -mount=app-interface pulp/stage/agents/gm-rh   # version, no values
# Prints a status line only, never the ids or the token.
set -euo pipefail
# The session invokes this helper and controls its environment, and this is the only
# place the AppRole ids are read, so every knob that could redirect them off this Vault
# or weaken the TLS to it is fixed here, NOT taken from the environment (a ${VAR:-default}
# would let the session override it). This mirrors gitea-api's hardcoded host. So: drop
# any TLS-verify, custom-CA and proxy settings the vault CLI honours, then pin the
# address unconditionally.
unset VAULT_SKIP_VERIFY VAULT_CACERT VAULT_CAPATH VAULT_CLIENT_CERT VAULT_CLIENT_KEY \
      VAULT_TLS_SERVER_NAME VAULT_PROXY_ADDR VAULT_HTTP_PROXY \
      HTTPS_PROXY HTTP_PROXY ALL_PROXY https_proxy http_proxy all_proxy
export VAULT_ADDR=https://vault.devshift.net
# Bound the login so an unreachable Vault cannot hang the pod's boot (the entrypoint calls
# this synchronously): a short per-request timeout AND no retries (the CLI otherwise
# retries ~2x with backoff on a 60s-per-request default, so boot could stall for minutes).
export VAULT_CLIENT_TIMEOUT=15 VAULT_MAX_RETRIES=0
ridf=${VAULT_ROLE_ID_FILE:-/run/secrets/vault-approle/role_id}
sidf=${VAULT_SECRET_ID_FILE:-/run/secrets/vault-approle/secret_id}
[ -s "$ridf" ] && [ -s "$sidf" ] \
  || { echo "gm-vault-login: no AppRole id files (mount not populated yet)" >&2; exit 2; }
command -v vault >/dev/null 2>&1 \
  || { echo "gm-vault-login: vault CLI not installed" >&2; exit 2; }
# key=@file makes vault read the id values from the files, so they never appear on a
# command line or in this shell's environment.
if ! tok=$(vault write -field=token auth/approle/login \
             role_id=@"$ridf" secret_id=@"$sidf" 2>/dev/null); then
  echo "gm-vault-login: AppRole login to $VAULT_ADDR failed" >&2
  exit 1
fi
( umask 077; printf '%s' "$tok" > "$HOME/.vault-token" )
unset tok
echo "gm-vault-login: token written for $VAULT_ADDR (vault CLI ready)"
