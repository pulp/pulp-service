#!/bin/bash
# Before buzz-acp starts: standing instructions come from the image only (an injected
# session must not persist itself in settings or memory across restarts).
set -euo pipefail
# The template sets CLAUDE_CONFIG_DIR, AGENT_WORKDIR and HOME only when it means to
# override them; default all three the same way the base agent-entrypoint does, so
# the pod starts under set -u even when the template leaves them unset. HOME must
# match the base's default so git finds the credentials this entrypoint writes:
# the base execs buzz-acp with HOME=${HOME:-/home/agent} and reads git config and
# ~/.git-credentials from there, so write them to the same HOME, not serrano's
# /state/home.
STATE=${AGENT_STATE_DIR:-/state}
export CLAUDE_CONFIG_DIR=${CLAUDE_CONFIG_DIR:-$STATE/claude}
export AGENT_WORKDIR=${AGENT_WORKDIR:-$STATE/work}
export HOME=${HOME:-/home/agent}
mkdir -p "$CLAUDE_CONFIG_DIR" "$AGENT_WORKDIR" "$HOME"
# AGENT_PUBKEY comes from the template param. Boot-resume and the profile set need
# it; a missing one is logged and that step skipped, not fatal.
AGENT_PUBKEY=${AGENT_PUBKEY:-}
rm -rf "$CLAUDE_CONFIG_DIR/settings.json" "$CLAUDE_CONFIG_DIR/settings.local.json" "$CLAUDE_CONFIG_DIR/memory" "$CLAUDE_CONFIG_DIR/projects"/*/memory 2>/dev/null || true
# Gitea HTTPS auth for the two clones, written once here from the mounted token into
# the base's HOME so the session's git pull/push to rh/cluster and rh/agents just
# works. The session never reads the token itself: secret-guard blocks /run/secrets,
# and git reads $HOME/.git-credentials internally. gitea-api covers token-bearing
# API calls. Rewritten every boot, so it needs no persistence.
if [ -n "${GITEA_TOKEN_FILE:-}" ] && [ -s "${GITEA_TOKEN_FILE:-}" ]; then
  git config --global credential.helper store
  ( umask 077; printf 'https://gm-rh:%s@gitea.bouterse.casa\n' "$(cat "$GITEA_TOKEN_FILE")" > "$HOME/.git-credentials" )
fi
# GitHub auth (hosted-pulp-bot) for pushing branches and merging PRs on pulp-service,
# and GitLab auth (alcove-bot) for app-interface MRs from the hosted-pulp group fork.
# Same pattern as Gitea above: written here from the mounted tokens into the base's
# HOME so the session's git push just works, with the session never reading the token
# (secret-guard blocks the secret mount; git reads the credential store internally).
# github-api and glab cover the token-bearing API calls. Appended with >>, so the
# Gitea line above stays. Each block is optional: an absent or empty token file (the
# mounts are optional: true) skips it, so the pod still boots before the secrets land.
if [ -n "${GITHUB_TOKEN_FILE:-}" ] && [ -s "${GITHUB_TOKEN_FILE:-}" ]; then
  git config --global credential.helper store
  ghuser=$(cat "${GITHUB_USERNAME_FILE:-/run/secrets/github/username}" 2>/dev/null || true)
  ( umask 077; printf 'https://%s:%s@github.com\n' "${ghuser:-hosted-pulp-bot}" "$(cat "$GITHUB_TOKEN_FILE")" >> "$HOME/.git-credentials" )
fi
if [ -n "${GITLAB_TOKEN_FILE:-}" ] && [ -s "${GITLAB_TOKEN_FILE:-}" ]; then
  git config --global credential.helper store
  gluser=$(cat "${GITLAB_USERNAME_FILE:-/run/secrets/gitlab/username}" 2>/dev/null || true)
  ( umask 077; printf 'https://%s:%s@gitlab.cee.redhat.com\n' "${gluser:-alcove-bot}" "$(cat "$GITLAB_TOKEN_FILE")" >> "$HOME/.git-credentials" )
  # glab reads its token from its config file, not the environment, so the token stays
  # out of the session's process env (nothing to leak through a stray printenv).
  glcfg="$HOME/.config/glab-cli"
  mkdir -p "$glcfg"
  ( umask 077; cat > "$glcfg/config.yml" <<GLAB
hostname: gitlab.cee.redhat.com
git_protocol: https
hosts:
    gitlab.cee.redhat.com:
        token: $(cat "$GITLAB_TOKEN_FILE")
        git_protocol: https
        api_protocol: https
        api_host: gitlab.cee.redhat.com
GLAB
  )
fi
# Vault AppRole login (pulp-buzz-agents-gm-rh) so the session can read and write the agent
# secrets under app-interface/pulp/stage/agents/* on vault.devshift.net without ever
# reading the mounted role_id/secret_id itself. Same pattern as the credentials above:
# gm-vault-login reads the ids here and writes only the resulting token to the vault CLI's
# token helper ($HOME/.vault-token); the session re-runs gm-vault-login to refresh the
# 30-min AppRole token. VAULT_ADDR is exported (not a secret) so `vault` just works for
# the session. Optional and non-fatal: an absent id file (the mount is optional: true) or
# a login failure only skips it, so the pod still boots before the secret lands.
export VAULT_ADDR=${VAULT_ADDR:-https://vault.devshift.net}
/usr/local/bin/gm-vault-login || echo "gm-entrypoint: vault approle login skipped/failed (non-fatal)" >&2
# First-boot state restore (see gm-state-restore): lay goals-state and the workspace
# down from the state repo before boot-resume or the heartbeat read them. Marker
# gated, fill-only and non-fatal, and it needs the git credentials written just above,
# so it runs here, synchronously, before the background helpers.
/usr/local/bin/gm-state-restore || true
# Boot resume (see boot-resume), in the background once buzz-acp is up. Extracted
# into its own script so the resumed turn writes start and end lines to the turn
# log the stop hold reads (pulp-service #1586), the same as any other turn.
/usr/local/bin/boot-resume &
# Graceful restart (items 13/14): replay mentions missed since the pod stopped,
# keep a liveness floor so a crash is covered too, and answer the threads the
# preStop hook announced the restart in. The floor must be read before the touch
# loop recreates alive-at.
floor="$(/usr/local/bin/agent-restart-floor || true)"
[ -n "$floor" ] && export BUZZ_ACP_REPLAY_FLOOR="$floor"
/usr/local/bin/agent-alive-touch &
/usr/local/bin/agent-restart-back &
exec /usr/local/bin/agent-entrypoint "$@"
