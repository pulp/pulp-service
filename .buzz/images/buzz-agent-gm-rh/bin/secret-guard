#!/usr/bin/env python3
"""Claude Code PreToolUse hook: keep credentials off the screen (determinism item 3).

Charter rule it enforces: never run env or printenv, never print a credential,
read a secret file only to hand it to the tool that needs it. Installed through
/etc/claude-code/managed-settings.json (root owned), so a session cannot turn it off.

Reads the hook event on stdin. Exit 0 lets the call run; exit 2 blocks it and the
reason on stderr goes back to the session. It is a tripwire for accidents, not a
fence against a session set on leaking: the named tools (gitea-api, git through
~/.git-credentials, sops via SOPS_AGE_KEY_FILE, gm-store-credential) read their
secrets inside their own code, so no allowed command needs a secret path.
"""
import json
import os
import re
import shlex
import sys

# Paths that hold a credential. Any mention in a command, or as a Read/Grep/Edit path, is blocked.
SECRET_PATHS = [
    r"/(?:var/)?run/secrets\b",
    r"/proc/[^/\s]+/environ\b",
    r"\.git-credentials\b",
    r"/state/bw\b",
    r"\.credentials\.json\b",
    r"\.claude/\.credentials",
]
SECRET_PATH_RE = re.compile("|".join(SECRET_PATHS))

# Environment names that carry a credential (values never shown). *_FILE names
# point at a file, so they are judged by where the file is (below).
SECRET_NAME_RE = re.compile(r"(PRIVATE_KEY|TOKEN|SECRET|PASSWORD|PASSWD|AUTH_TAG|API_KEY)", re.I)

# Commands that dump the environment when run with no command of their own.
ENV_DUMPERS = {"env", "printenv"}
SEGMENT_SPLIT = re.compile(r"\|\||&&|[;|&\n(){}`]|\$\(")


def secret_env_names():
    names = set()
    for k, v in os.environ.items():
        if v.startswith(("/run/secrets", "/var/run/secrets")):
            names.add(k)
        elif SECRET_NAME_RE.search(k) and not k.endswith("_FILE"):
            names.add(k)
    return names


def words(segment):
    try:
        return shlex.split(segment, comments=True)
    except ValueError:
        return segment.split()


def command_word(ws):
    """First word that is the command: skip VAR=x prefixes and wrappers."""
    i = 0
    while i < len(ws) and (re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", ws[i]) or ws[i] in {"sudo", "exec", "command", "nohup", "time", "xargs"}):
        i += 1
    return (ws[i] if i < len(ws) else ""), ws[i + 1:]


def dumps_env(cmd, args):
    base = os.path.basename(cmd)
    if base == "printenv":
        return True
    if base == "env":
        # env with flags only prints everything; env NAME=v cmd runs cmd.
        rest = [a for a in args if not a.startswith("-")]
        return not rest or all("=" in a for a in rest)
    if base in {"export", "declare", "typeset"}:
        return not args or all(a.startswith("-") and set(a[1:]) & set("px") for a in args)
    if base == "set":
        return not args
    return False


def check_bash(command, _depth=0):
    m = SECRET_PATH_RE.search(command)
    if m:
        return f"mentions the secret path {m.group(0)!r}; use the tool that needs it (gitea-api, git, sops, gm-store-credential)"
    for name in secret_env_names():
        if re.search(r"\$\{?" + re.escape(name) + r"\b", command):
            return f"expands ${name}, which holds a credential or points at one"
    for seg in SEGMENT_SPLIT.split(command):
        ws = words(seg)
        cmd, args = command_word(ws)
        if dumps_env(cmd, args):
            return f"{os.path.basename(cmd)} would print the environment; use compgen -e for names only"
        # A nested shell runs its own command string: check that too (bash -c 'env').
        base = os.path.basename(cmd)
        inner = None
        if base in {"bash", "sh", "dash", "zsh", "ksh", "su"} and "-c" in args and args.index("-c") + 1 < len(args):
            inner = args[args.index("-c") + 1]
        elif base == "eval":
            inner = " ".join(args)
        if inner is not None and _depth < 5:
            reason = check_bash(inner, _depth + 1)
            if reason:
                return reason
        # A command run inside a pod: kubectl exec ... -- env
        if os.path.basename(cmd) == "kubectl" and "--" in args:
            inner, inner_args = command_word(args[args.index("--") + 1:])
            if dumps_env(inner, inner_args):
                return "kubectl exec would print the pod's environment"
        gi = args.index("get") if "get" in args else -1
        if os.path.basename(cmd) == "kubectl" and 0 <= gi < len(args) - 1 and args[gi + 1].split("/")[0] in {"secret", "secrets"}:
            if re.search(r"(^|\s)(-o|--output)[ =]?(yaml|json|jsonpath|go-template|template)", " ".join(args)):
                return "kubectl get secret with values; use kubectl get secret without -o, or describe"
        if os.path.basename(cmd) == "sops" and ({"-d", "--decrypt"} & set(args)) and not any(a.startswith("--output") for a in args):
            if ">" not in seg:
                return "sops --decrypt to the screen; decrypt into a file under a 700 directory (--output) or let the tool that needs it read it"
    return None


def check_path(path):
    m = SECRET_PATH_RE.search(path or "")
    return f"path {path!r} holds a credential" if m else None


def main():
    try:
        event = json.load(sys.stdin)
    except ValueError:
        print("secret-guard: unreadable hook input, blocked", file=sys.stderr)
        return 2
    tool = event.get("tool_name", "")
    inp = event.get("tool_input") or {}
    if tool == "Bash":
        reason = check_bash(inp.get("command", ""))
    elif tool in {"Read", "Edit", "Write", "NotebookEdit"}:
        reason = check_path(inp.get("file_path") or inp.get("notebook_path"))
    elif tool in {"Grep", "Glob"}:
        reason = check_path(inp.get("path")) or check_path(inp.get("pattern") if tool == "Glob" else "")
    else:
        reason = None
    if reason:
        print(f"secret-guard blocked {tool}: {reason}. (Charter: credentials never on screen.)", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
