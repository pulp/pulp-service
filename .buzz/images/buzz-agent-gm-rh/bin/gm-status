#!/bin/bash
# The RH platform's state in one screen, for the daily status, from where gm-rh now
# runs: an always on Buzz agent on Red Hat's OpenShift (pulp-agents-stage). Every check
# prints its own line; a check that cannot run prints "CHECK FAILED" so the report never
# claims all clean. A check that does not apply from here prints "n/a here", which
# gm-daily treats as clean, so the report never reads as a failure for an expected gap.
#
# What gm-rh reads from here: the relay and the two git repos over HTTPS, and pod
# readiness in pulp-agents-stage through its own read-only ServiceAccount (the built-in
# view role, no writes). The SaaS rollout, Flux (there is none for agents here), TLS
# certificates and in-pod restart state (which need exec) stay Brian's to check with oc
# from the Mac; this tool does not guess at them. The serrano-only checks (flux
# kustomization, openssl certs, kubectl exec agent-restart-stuck, the four-namespace
# sweep, gm-gate-drops, gm-chief-sync) live on the serrano image, not here.
set -uo pipefail
line() { printf '%s\n' "$*"; }
run() { local name=$1; shift; local out; out=$("$@" 2>&1) && line "$name: ${out:-none}" || line "$name: CHECK FAILED: ${out:0:200}"; }

# Pod readiness in pulp-agents-stage via gm-rh's read-only ServiceAccount (view role, no
# writes). No kube client ships in this image, so it calls the in-cluster API directly with
# the projected token and the mounted CA (curl, GET only), flagging any pod that is not
# healthy: phase not Running/Succeeded, or Running with a container not ready (catches
# CrashLoopBackOff/Error that phase alone misses). Degrades cleanly: with no projected token
# it prints "n/a here" (gm-daily reads that as clean); a failed or non-200 API call prints
# CHECK FAILED, so a real outage never reads as clean. Read only: it only GETs pods.
KUBE_NS=${KUBE_NS:-pulp-agents-stage}
pods_not_ready() {
  local ns=${KUBE_NS:-pulp-agents-stage}
  local sa=/var/run/secrets/kubernetes.io/serviceaccount
  [ -r "$sa/token" ] || { echo "n/a here"; return 0; }
  local api="https://${KUBERNETES_SERVICE_HOST}:${KUBERNETES_SERVICE_PORT}"
  local body code msg out
  body=$(mktemp)
  code=$(curl -sS -m 20 -o "$body" -w '%{http_code}' \
    --cacert "$sa/ca.crt" \
    -H "Authorization: Bearer $(cat "$sa/token")" \
    "$api/api/v1/namespaces/$ns/pods" 2>/dev/null) || { rm -f "$body"; echo "API call failed"; return 1; }
  if [ "$code" != 200 ]; then
    msg=$(jq -r '.message // empty' "$body" 2>/dev/null); rm -f "$body"
    echo "API HTTP $code${msg:+: $msg}"; return 1
  fi
  out=$(jq -r '
    .items[]
    | select(
        (.status.phase != "Running" and .status.phase != "Succeeded")
        or (.status.phase == "Running"
            and ([.status.containerStatuses[]?.ready] | any(. == false)))
      )
    | "\(.metadata.name)(\(.status.phase))"
  ' "$body" | paste -sd ";" -)
  rm -f "$body"
  printf '%s' "$out"
}
run "agent pods not ready ($KUBE_NS)" pods_not_ready

# Relay liveness: each RH agent's presence on buzz-rh. FLEET is "slug=pubkey" pairs,
# space separated; default the agents that are live once gm-rh itself is (enable order
# puts cos-rh before gm-rh). Add auditor-rh and PulpBot to FLEET (template env) when
# they deploy. An agent not "online", or whose presence is stale beyond LIVENESS_STALE
# seconds, is flagged; "none" means every agent in FLEET is online and fresh.
FLEET=${FLEET:-"gm-rh=6c6d64a0b90c4f1dbce52c14cf05f26cc4f2ab6233576c6a23cac7e157dbde93 cos-rh=6a14bf7b3d7259f77e5b40a4817a084b11002f54e585eda431c4befa5d150c0d"}
LIVENESS_STALE=${LIVENESS_STALE:-5400}
BUZZ=${BUZZ:-buzz}
run "relay liveness" bash -o pipefail -c '
  fleet="'"$FLEET"'"; stale='"$LIVENESS_STALE"'; now=$(date +%s)
  keys=$(for pair in $fleet; do printf "%s\n" "${pair#*=}"; done | paste -sd, -)
  [ -n "$keys" ] || { echo "no FLEET configured"; exit 1; }
  pres=$('"$BUZZ"' --format compact users presence --pubkeys "$keys") || exit 1
  bad=""
  for pair in $fleet; do
    slug=${pair%%=*}; pk=${pair#*=}
    row=$(printf "%s" "$pres" | jq -r --arg pk "$pk" ".[] | select(.pubkey==\$pk) | \"\(.status) \(.updated_at)\"")
    if [ -z "$row" ]; then bad="$bad $slug(no-presence)"; continue; fi
    st=${row% *}; up=${row#* }
    age=$(( now - up ))
    if [ "$st" != online ] || [ "$age" -gt "$stale" ]; then bad="$bad $slug($st/${age}s)"; fi
  done
  printf "%s" "${bad# }"
'
# Mentions net: any message by a chief or agent (not an approver) on the relay that
# wrote a backticked @Name with no p tag, so the mention woke nobody. gm-post guards
# gm-rh's own posts; this catches the others.
run "backticked mentions (no p tag)" gm-backtick-scan
# Approval-check (determinism item 2): any commit on rh/cluster main since yesterday
# that is MISSING a valid "Approved by <event id>" line or whose named yes is BAD. The
# shared tools/approval-check, run over a fresh clone with gm-rh's token (CHECK FAILED
# if gitea is unreachable from the cluster).
run "approvals since yesterday" gm-approvals
# Digest bumps under rh/cluster deploy/ whose commit lacks the matching pin-digest
# line (determinism item 4). Warn only; covers the interim serrano workloads while
# they are retired. pin-digest prints CHECK FAILED itself and exits non-zero.
run "digest bumps without pin-digest proof (since yesterday)" bash -o pipefail -c "git -C /state/repos/cluster pull -q && cd /state/repos/cluster && pin-digest --check --since yesterday | paste -sd ';' -"
