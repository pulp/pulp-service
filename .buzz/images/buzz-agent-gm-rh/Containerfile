# buzz-agent-gm-rh: the Red Hat GM image for OpenShift. It is the shared
# buzz-agent-base plus gm-rh's tamper-proof half, baked root owned per model C: its
# bin tools (buzz lives in the base; these are the gm tools gitea-api, github-api,
# gm-approvals, gm-backtick-scan, gm-daily, gm-goals, gm-pending, gm-post, gm-status,
# pin-digest, secret-guard, the gm-entrypoint, the sourceable agent-runtime-env, and
# the restart/alive/prestop helpers), glab (the GitLab CLI, installed below), the
# baked approver list and goal files
# (approval-check.env, goals.md, goal-checks), the boot resume prompt, and the
# managed-settings.json that wires the secret-guard hook. Charter, heartbeat.md,
# skills and mcp.json come from the git definition at .buzz/agents/gm-rh/, so a
# charter or heartbeat edit is a push, not an image rebuild. Built by pulp-service CI
# to ghcr.io/pulp/buzz-agent-gm-rh.
#
# The patched base: buzz-agent-base v0.2.4 carries the heartbeat patch
# (patches/agent-base-heartbeat.diff), tzdata, the mcp.json fix (no /dev/fd) and
# the empty-channels fix, so gm-rh's hourly heartbeat (daily status, goals,
# gm-pending) arms. v0.2.4 also carries the SIGTERM stop hold (agent-stop-hold):
# the entrypoint holds the pod's SIGTERM until buzz-acp's in flight turn ends,
# reading buzz-acp's turn log (pool::prompt enabled) so the turn drains within the
# grace period instead of being aborted (gate 1, pulp-service #1583/#1584/#1585).
# Bump the tag and digest below deliberately (same rule as the base).
FROM ghcr.io/pulp/buzz-agent-base:v0.2.5@sha256:8d3f0a38e1c29293827d28f3ed584d8e032bf524f75bc3defe8bc8820b6cfe98
USER root
# glab (GitLab CLI) for app-interface MRs and /lgtm as alcove-bot, pinned to a release
# and verified against its published checksum. Fetched at build time (the build host
# has egress); the static linux amd64 binary runs on this Alpine base. To bump, change
# both ARGs together from the release's checksums.txt.
ARG GLAB_VERSION=1.123.0
ARG GLAB_SHA256=9c9ac4c2b74ec8709dec4819a4041050f3680c6aaa18f0ed30434081f4fe9bef
RUN set -eux; \
      url="https://gitlab.com/api/v4/projects/gitlab-org%2Fcli/packages/generic/glab/${GLAB_VERSION}/glab_${GLAB_VERSION}_linux_amd64.tar.gz"; \
      curl -sSL -o /tmp/glab.tgz "$url"; \
      echo "${GLAB_SHA256}  /tmp/glab.tgz" | sha256sum -c -; \
      tar -xzf /tmp/glab.tgz -C /tmp bin/glab; \
      install -m 0755 /tmp/bin/glab /usr/local/bin/glab; \
      rm -rf /tmp/glab.tgz /tmp/bin; \
      glab --version
# vault (HashiCorp CLI) for the AppRole login at boot and for the session's token lookup,
# KV metadata/version reads and token placements on vault.devshift.net, pinned to a
# release and verified against its published SHA256SUMS. Fetched at build time (the build
# host has egress); the static linux amd64 binary runs on this Alpine base. To bump,
# change both ARGs together from that release's vault_<version>_SHA256SUMS. Pinned to
# match the vault.devshift.net server version (1.19.5) to avoid CLI/server skew.
ARG VAULT_VERSION=1.19.5
ARG VAULT_SHA256=5192111920b3f745c10f8fea9988c46b91414a69bcf49df1f7c87880d80a3755
RUN set -eux; \
      url="https://releases.hashicorp.com/vault/${VAULT_VERSION}/vault_${VAULT_VERSION}_linux_amd64.zip"; \
      curl -sSL -o /tmp/vault.zip "$url"; \
      echo "${VAULT_SHA256}  /tmp/vault.zip" | sha256sum -c -; \
      unzip -o /tmp/vault.zip vault -d /tmp; \
      install -m 0755 /tmp/vault /usr/local/bin/vault; \
      rm -rf /tmp/vault.zip /tmp/vault; \
      vault version
# gitlab.cee.redhat.com serves a chain under Red Hat IT's Internal Root CA, which the
# base trust store lacks, so git push and glab to the app-interface fork fail on TLS
# without it. Add it to the system store and point Python and Node clients at that
# store too, the same way the pulpbot image does.
COPY rh-internal-root-ca.crt /usr/local/share/ca-certificates/rh-internal-root-ca.crt
RUN update-ca-certificates 2>/dev/null \
 && grep -q "$(sed -n '5p' /usr/local/share/ca-certificates/rh-internal-root-ca.crt)" /etc/ssl/certs/ca-certificates.crt
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
    REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt \
    NODE_EXTRA_CA_CERTS=/usr/local/share/ca-certificates/rh-internal-root-ca.crt
# Tools onto PATH; config into /opt/agent. Root owned so the running agent (an
# arbitrary OpenShift UID in group 0) cannot rewrite its own approver list, goals,
# or the secret-guard hook. agent-runtime-env is sourced, not executed, so it stays
# non-executable like its neighbours in the base.
COPY bin/ /usr/local/bin/
COPY approval-check.env boot-resume.md goals.md goal-checks managed-settings.json /opt/agent/
# gm-pending and gm-daily read the baked approver list and channels from here; fixed
# in the image, not overridable at runtime, so a compromised session cannot widen its
# own approver set.
ENV PENDING_ENV=/opt/agent/approval-check.env
RUN chmod 0755 /usr/local/bin/agent-alive-touch /usr/local/bin/agent-prestop \
      /usr/local/bin/agent-restart-back /usr/local/bin/agent-restart-floor \
      /usr/local/bin/agent-restart-stuck /usr/local/bin/boot-resume \
      /usr/local/bin/gitea-api /usr/local/bin/github-api /usr/local/bin/gm-approvals \
      /usr/local/bin/gm-backtick-scan /usr/local/bin/gm-daily /usr/local/bin/gm-entrypoint \
      /usr/local/bin/gm-goals /usr/local/bin/gm-pending /usr/local/bin/gm-post \
      /usr/local/bin/gm-status /usr/local/bin/gm-vault-login /usr/local/bin/pin-digest \
      /usr/local/bin/secret-guard \
 && chmod 0644 /opt/agent/approval-check.env /opt/agent/boot-resume.md /opt/agent/goals.md \
      /opt/agent/goal-checks /opt/agent/managed-settings.json \
 && chmod -R go-w /opt/agent \
 # Claude Code loads enterprise-managed settings from this path; root owned and read
 # only so the session cannot disable its own secret-guard hook.
 && install -D -m 644 -o root -g root /opt/agent/managed-settings.json /etc/claude-code/managed-settings.json
USER 1000
WORKDIR /home/agent
ENTRYPOINT ["/usr/local/bin/gm-entrypoint"]
