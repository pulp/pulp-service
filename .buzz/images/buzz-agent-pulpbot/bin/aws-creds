#!/bin/bash
# aws-creds: turn a DM reply that carries AWS credentials into a safe, sourceable env
# file. The requester runs rh-aws-saml-login on their own machine and replies in the DM
# with the AWS_* lines; dm-watch writes that reply to /run/agent-session/<hex>/<file>.
# Sourcing that reply directly would run whatever the requester sent, so this tool reads
# it and keeps only the expected AWS_* assignments, each re-emitted single-quoted so the
# value cannot run as shell. The raw reply is deleted after parsing.
#
# Usage: aws-creds --requester <hex> --file <reply-file> [--out <name>]
#   Reads  /run/agent-session/<hex>/<reply-file>
#   Writes /run/agent-session/<hex>/<out>  (default aws.env), mode 600, and prints its
#   path. Source that file for the AWS commands that need it:  . <path>
set -uo pipefail

requester=""; file=""; out="aws.env"
while [ $# -gt 0 ]; do
  case "$1" in
    --requester) requester="$2"; shift 2 ;;
    --file)      file="$2";      shift 2 ;;
    --out)       out="$2";       shift 2 ;;
    *) echo "aws-creds: unknown argument '$1'" >&2; exit 2 ;;
  esac
done
[ -n "$requester" ] && [ -n "$file" ] || { echo "usage: aws-creds --requester <hex> --file <reply-file> [--out <name>]" >&2; exit 2; }
case "$requester" in *[!0-9a-f]*|"") echo "aws-creds: --requester must be 64 hex" >&2; exit 2 ;; esac
[ ${#requester} -eq 64 ] || { echo "aws-creds: --requester must be 64 hex" >&2; exit 2; }
case "$file" in */*|"") echo "aws-creds: --file must be a plain filename" >&2; exit 2 ;; esac
case "$out" in */*|"") echo "aws-creds: --out must be a plain filename" >&2; exit 2 ;; esac

dir="/run/agent-session/$requester"
reply="$dir/$file"
dest="$dir/$out"
[ -s "$reply" ] || { echo "aws-creds: no reply at the session file for $requester/$file" >&2; exit 3; }

n=0
( umask 077; : > "$dest" )
while IFS= read -r line; do
  line=${line%$'\r'}  # a reply pasted with CRLF line endings
  line="${line#export }"
  case "$line" in
    AWS_ACCESS_KEY_ID=*|AWS_SECRET_ACCESS_KEY=*|AWS_SESSION_TOKEN=*|AWS_REGION=*|AWS_DEFAULT_REGION=*) : ;;
    *) continue ;;
  esac
  name="${line%%=*}"; val="${line#*=}"
  # Drop surrounding quotes the requester's shell may have added.
  val="${val%\"}"; val="${val#\"}"; val="${val%\'}"; val="${val#\'}"
  [ -n "$val" ] || continue
  # Re-emit single-quoted, embedded single quotes escaped, so the value is data not code.
  esc=${val//\'/\'\\\'\'}
  ( umask 077; printf "export %s='%s'\n" "$name" "$esc" >> "$dest" )
  n=$((n+1))
done < "$reply"

rm -f "$reply"
if [ "$n" -eq 0 ] || ! grep -q '^export AWS_ACCESS_KEY_ID=' "$dest" || ! grep -q '^export AWS_SECRET_ACCESS_KEY=' "$dest"; then
  rm -f "$dest"
  echo "aws-creds: the reply had no usable AWS credentials (need at least AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY)" >&2
  exit 4
fi
echo "$dest"
