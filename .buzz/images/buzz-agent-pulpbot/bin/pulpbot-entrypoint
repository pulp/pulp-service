#!/bin/bash
# PulpBot's entrypoint shim. Runs before the base agent-entrypoint to turn the
# mounted standing secrets into the environment and git setup PulpBot's tools
# expect, then execs the base entrypoint, which reads nsec and starts buzz-acp.
# Nothing here prints a secret value: each file is read straight into a variable
# or a mode 600 file and never echoed. The session never reads the secret files
# itself; it uses the exported vars, the netrc and the git credential store.
set -uo pipefail

STATE=${AGENT_STATE_DIR:-/state}
export CLAUDE_CONFIG_DIR=${CLAUDE_CONFIG_DIR:-$STATE/claude}
export AGENT_WORKDIR=${AGENT_WORKDIR:-$STATE/work}
export HOME=${HOME:-/home/agent}
mkdir -p "$CLAUDE_CONFIG_DIR" "$AGENT_WORKDIR" "$HOME"

SEC=${AGENT_SECRET_DIR:-/run/secrets/agent}

# Export a standing secret from its mounted file into the named variable, only when
# the file is present and non-empty. A missing one is logged by name (never value)
# and skipped, so the pod still starts and the affected tool reports it is not set.
export_secret() {
  local var="$1" file="$2"
  if [ -s "$file" ]; then
    export "$var=$(cat "$file")"
  else
    echo "pulpbot-entrypoint: $var not mounted; tools that need it will report it missing" >&2
  fi
}
export_secret SPLUNK_TOKEN     "$SEC/SPLUNK_TOKEN"
export_secret GLITCHTIP_TOKEN  "$SEC/GLITCHTIP_TOKEN"
export_secret GITLAB_TOKEN     "$SEC/GITLAB_TOKEN"
export_secret GH_TOKEN         "$SEC/GH_TOKEN"
export_secret TBR_USERNAME     "$SEC/TBR_USERNAME"
export_secret TBR_PASSWORD     "$SEC/TBR_PASSWORD"

# glab defaults to gitlab.com when it is not inside a gitlab.cee checkout, which would
# send GITLAB_TOKEN to the wrong host. Pin it to the internal instance so the alcove-bot
# token is only ever sent to gitlab.cee.redhat.com.
export GITLAB_HOST="${GITLAB_HOST:-gitlab.cee.redhat.com}"

# Pulp API netrc: mounted read only. Tools read it with curl --netrc-file "$NETRC";
# exported here so no tool has to name the secret path itself.
if [ -s "$SEC/pulp-netrc" ]; then
  export NETRC="$SEC/pulp-netrc"
else
  echo "pulpbot-entrypoint: pulp-netrc not mounted; Pulp API calls will have no credentials" >&2
fi

# Git credential store for the two push remotes, written once from the standing
# tokens into HOME so git push just works and no tool reads the token. alcove-bot
# on gitlab.cee.redhat.com (shows as alcove-bot), hosted-pulp-bot on github.com.
# Rewritten every boot, so it needs no persistence.
creds="$HOME/.git-credentials"
( umask 077
  : > "$creds"
  [ -n "${GITLAB_TOKEN:-}" ] && printf 'https://alcove-bot:%s@gitlab.cee.redhat.com\n' "$GITLAB_TOKEN" >> "$creds"
  [ -n "${GH_TOKEN:-}" ]     && printf 'https://hosted-pulp-bot:%s@github.com\n' "$GH_TOKEN" >> "$creds"
)
[ -s "$creds" ] && git config --global credential.helper store

# Commit identity for the work PulpBot authors in GitHub and GitLab. Exported as
# GIT_AUTHOR_* / GIT_COMMITTER_* so it wins over the per-agent default the base
# entrypoint writes to global git config, and stays overridable by the template.
# The push credential still decides which account the push shows as (alcove-bot on
# GitLab, hosted-pulp-bot on GitHub); this only names the commit author.
export GIT_AUTHOR_NAME="${AGENT_GIT_NAME:-Hosted Pulp Bot}"
export GIT_AUTHOR_EMAIL="${AGENT_GIT_EMAIL:-hosted-pulp-bot@users.noreply.github.com}"
export GIT_COMMITTER_NAME="$GIT_AUTHOR_NAME"
export GIT_COMMITTER_EMAIL="$GIT_AUTHOR_EMAIL"

# The base entrypoint reads nsec, installs the git definition and starts buzz-acp.
# The base v0.2.5 entrypoint also empties /run/agent-session (memory, 16Mi) at
# start, where dm-watch keeps per requester session tokens.
exec /usr/local/bin/agent-entrypoint "$@"
