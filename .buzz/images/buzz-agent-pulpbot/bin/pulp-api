#!/usr/bin/env bash
# pulp-api: a read-only call to the Pulp API on packages.redhat.com, with the TBR
# netrc read here, never by the session. secret-guard blocks a session that passes
# the netrc path, `curl -u`, or the credential value itself; this is the tool that
# holds it. The charter rule it serves: read a secret file only to hand it to the
# tool that needs it. This file is that tool. It mirrors gitea-api and gm-vault-login:
# the host is pinned here, not taken from the environment or the arguments, so the
# TBR credential can only ever go to packages.redhat.com.
#
#   pulp-api <METHOD> <PATH> [extra curl args...]
#
# METHOD is GET or HEAD only: the TBR account is read only, and the wrapper refuses
# any write verb so a typo or a confused request cannot attempt one. PATH is a path on
# packages.redhat.com with a leading slash, e.g.
#   pulp-api GET /api/pulp/default/api/v3/status/
# Everything after PATH is passed to curl, but screened by an allowlist first: only a
# few read-only flags are accepted (-s, -S, -f, -o <file>, -w <format>, -H with an
# Accept header), and everything else that starts with a dash, plus any stray token
# such as a second URL, is rejected. An allowlist is used, not a denylist, so a new
# curl flag that could dump the credential, redirect it, override auth, or weaken TLS
# cannot slip through by being unlisted.
#
# Examples:
#   pulp-api GET /api/pulp/default/api/v3/status/ | jq '.online_workers | length'
#   pulp-api HEAD /pulp/content/ -o /dev/null -w '%{http_code}\n'
set -euo pipefail

# The host is a literal here, never ${VAR:-...} and never from an argument, so the
# credential's destination cannot be redirected. This is the point gm-vault-login
# missed and gitea-api gets right.
base="https://packages.redhat.com"

# Pin the TLS trust the same way the host is pinned, not from the environment. The CA
# bundle is a literal baked path, re-exported over any SSL_CERT_FILE the session set,
# with SSL_CERT_DIR and CURL_CA_BUNDLE unset, and passed to curl as --cacert below. A
# session that set SSL_CERT_FILE=/tmp/rogue.pem (or SSL_CERT_DIR, or CURL_CA_BUNDLE) to
# a CA of its own could otherwise let a man in the middle present a fake
# packages.redhat.com cert and capture the TBR credential; pinning the store here
# blocks that. packages.redhat.com uses a public cert, so this base store verifies it.
# Also clear every proxy knob so the request cannot be routed through a proxy that would
# see the credential; -q below makes curl ignore ~/.curlrc.
cafile="/etc/ssl/certs/ca-certificates.crt"
export SSL_CERT_FILE="$cafile"
unset SSL_CERT_DIR CURL_CA_BUNDLE \
      HTTPS_PROXY HTTP_PROXY ALL_PROXY https_proxy http_proxy all_proxy

# The netrc path defaults to the mounted secret and may be overridden by NETRC (the
# entrypoint sets it); the value is never read by this script, only handed to curl via
# --netrc-file, and the pinned host means curl only ever sends the packages.redhat.com
# entry. An override cannot leak anything: a wrong netrc just fails auth.
netrc="${NETRC:-/run/secrets/agent/pulp-netrc}"
[ -s "$netrc" ] || { echo "pulp-api: no Pulp netrc at $netrc; Pulp API calls have no credentials" >&2; exit 2; }

[ $# -ge 2 ] || { echo "usage: pulp-api <GET|HEAD> <PATH> [curl args...]" >&2; exit 2; }
method=$1 path=$2; shift 2

case $method in
  GET|HEAD) ;;
  *) echo "pulp-api: refusing method $method (read only: GET or HEAD)" >&2; exit 2 ;;
esac
case $path in
  /*) ;;
  *) echo "pulp-api: PATH must start with / (a path on $base)" >&2; exit 2 ;;
esac

# Screen the extra curl args with an allowlist before any call runs. Only these flags
# are accepted; everything else that starts with a dash, and any stray token (a second
# URL, a value with no flag), is refused. Value-taking flags consume the next token:
# -o/--output (output file), -w/--write-out (format string), -H/--header (an Accept
# header only). Boolean flags carry no value: -s, -S, -f, their long forms, and bundles
# of those short forms (-sS, -sSf). An allowlist, not a denylist: a new leak/redirect/
# TLS-weakening flag cannot slip through unlisted (a denylist missed -X).
want=""   # when set, the next token is the value for this flag
for arg in "$@"; do
  if [ -n "$want" ]; then
    if [ "$want" = header ]; then
      case $arg in
        [Aa]ccept:*) ;;
        *) echo "pulp-api: refusing header '$arg' (only an Accept header is allowed)" >&2; exit 2 ;;
      esac
    fi
    want=""; continue
  fi
  case $arg in
    -s|-S|-f|--silent|--show-error|--fail) ;;
    -[sSf][sSf]|-[sSf][sSf][sSf]) ;;        # bundled booleans, e.g. -sS, -sSf
    -o|--output)    want=output ;;
    -w|--write-out) want=writeout ;;
    -H|--header)    want=header ;;
    --output=*|--write-out=*) ;;
    --header=[Aa]ccept:*) ;;
    --header=*)
      echo "pulp-api: refusing header '$arg' (only an Accept header is allowed)" >&2; exit 2 ;;
    http://*|https://*)
      echo "pulp-api: refusing extra URL $arg" >&2; exit 2 ;;
    *)
      echo "pulp-api: refusing arg '$arg' (allowed: -s -S -f, -o <file>, -w <format>, -H 'Accept: ...')" >&2; exit 2 ;;
  esac
done
[ -z "$want" ] || { echo "pulp-api: $want flag given with no value" >&2; exit 2; }

# HEAD uses -I, not -X HEAD: with -X HEAD curl waits for a response body that never
# comes and hangs until timeout. GET is curl's default, so it needs no -X.
if [ "$method" = HEAD ]; then req=(-I); else req=(); fi

# -q makes curl skip ~/.curlrc (which a session could write to log or redirect the
# request). The credential reaches curl only through --netrc-file, so its value never
# appears on a command line where another process could read it.
exec curl -q -sS --connect-timeout 15 --cacert "$cafile" --netrc-file "$netrc" \
  "${req[@]}" "$base$path" "$@"
