#!/usr/bin/env python3
"""Wait until the agent is idle, for the stop path in agent-entrypoint.

    agent-stop-hold <claude config dir> <idle seconds> <cap seconds>

buzz-acp gives an in flight turn only 30 seconds after SIGTERM and then kills it
(block/buzz#8392). So agent-entrypoint holds the pod's SIGTERM here first and
passes it on once the agent is idle: no Claude Code session transcript
(<config dir>/projects/*/*.jsonl) written for <idle seconds>. A turn writes its
transcript as it goes, so a quiet transcript means no turn is running. Exits 0
when idle, 3 when <cap seconds> pass first; the caller sends SIGTERM either way.
"""
import glob
import os
import sys
import time


def last_write(config_dir: str) -> float:
    newest = 0.0
    for path in glob.glob(os.path.join(config_dir, "projects", "*", "*.jsonl")):
        try:
            newest = max(newest, os.stat(path).st_mtime)
        except OSError:
            pass  # a transcript removed between the glob and the stat
    return newest


def main() -> int:
    config_dir, idle, cap = sys.argv[1], float(sys.argv[2]), float(sys.argv[3])
    deadline = time.time() + cap
    while True:
        last = last_write(config_dir)
        quiet_for = time.time() - last
        if quiet_for >= idle:
            why = f"{quiet_for:.0f}s since the last transcript write" if last else "no transcripts"
            print(f"agent-stop-hold: idle ({why})", flush=True)
            return 0
        if time.time() >= deadline:
            print(f"agent-stop-hold: still busy after {cap:.0f}s; stopping anyway", flush=True)
            return 3
        time.sleep(1)


if __name__ == "__main__":
    sys.exit(main())
