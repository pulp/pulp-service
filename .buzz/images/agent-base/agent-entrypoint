#!/usr/bin/env bash
# Starts buzz-acp for one always on agent on OpenShift.
# The definition comes from git (AGENT_DEFINITION_REPO at AGENT_DEFINITION_REF,
# folder .buzz/agents/$AGENT_SLUG); a watcher re-fetches every five minutes and
# restarts buzz-acp when the commit changes. Secrets are mounted files under
# /run/secrets and are never printed.
set -uo pipefail
: "${AGENT_SLUG:?}" "${AGENT_DEFINITION_REPO:?}" "${AGENT_DEFINITION_REF:=main}" "${AGENT_REVISION:?}"
STATE=${AGENT_STATE_DIR:-/state}
export CLAUDE_CONFIG_DIR=${CLAUDE_CONFIG_DIR:-$STATE/claude}
export AGENT_WORKDIR=${AGENT_WORKDIR:-$STATE/work}
export HOME=${HOME:-/home/agent}
REPO_DIR=$STATE/definition
DEF=$REPO_DIR/.buzz/agents/$AGENT_SLUG
ACP=${BUZZ_ACP_BIN:-buzz-acp}
WATCH_SECONDS=${AGENT_DEFINITION_WATCH_SECONDS:-300}
mkdir -p "$CLAUDE_CONFIG_DIR" "$AGENT_WORKDIR" "$STATE"

# Keys from the mounted Vault secret; absent means do not start.
SEC=${AGENT_SECRET_DIR:-/run/secrets/agent}
if [ -s "$SEC/nsec" ]; then export BUZZ_PRIVATE_KEY="$(cat "$SEC/nsec")"; else echo "agent-entrypoint: $SEC/nsec missing"; exit 1; fi
# The owner tag is public. The definition's auth-tag file wins when present, so
# an ownership change is a git push; the Vault copy is the fallback.
VAULT_AUTH_TAG=""
[ -s "$SEC/auth-tag" ] && VAULT_AUTH_TAG="$(cat "$SEC/auth-tag")"

fetch_definition() {
  if [ -d "$REPO_DIR/.git" ]; then
    timeout "${AGENT_GIT_TIMEOUT:-120}" git -C "$REPO_DIR" fetch -q --depth 1 origin "$AGENT_DEFINITION_REF" && git -C "$REPO_DIR" reset -q --hard FETCH_HEAD
  else
    rm -rf "$REPO_DIR"
    timeout "${AGENT_GIT_TIMEOUT:-120}" git clone -q --depth 1 --branch "$AGENT_DEFINITION_REF" "$AGENT_DEFINITION_REPO" "$REPO_DIR"
  fi
}
# The agent tracks its own subtree, not the monorepo: an unrelated merge to
# main must not restart it.
current_tree() { git -C "$REPO_DIR" rev-parse "HEAD:.buzz/agents/$AGENT_SLUG" 2>/dev/null; }
current_commit() { git -C "$REPO_DIR" rev-parse HEAD 2>/dev/null; }

install_definition() {
  [ -d "$DEF" ] || { echo "agent-entrypoint: no definition at .buzz/agents/$AGENT_SLUG"; return 1; }
  # The definition is the whole truth: nothing from an earlier revision lingers.
  rm -rf "$CLAUDE_CONFIG_DIR/skills" "$CLAUDE_CONFIG_DIR/CLAUDE.md"
  [ -f "$DEF/CLAUDE.md" ] && cp "$DEF/CLAUDE.md" "$CLAUDE_CONFIG_DIR/CLAUDE.md"
  [ -d "$DEF/skills" ] && cp -R "$DEF/skills" "$CLAUDE_CONFIG_DIR/skills"
  local cj="$CLAUDE_CONFIG_DIR/.claude.json"
  [ -s "$cj" ] || echo '{"hasCompletedOnboarding":true}' > "$cj"
  # No /dev/fd in the pod, so no process substitution: read mcp.json if present.
  local servers='{}'; [ -f "$DEF/mcp.json" ] && servers="$(jq -c '.mcpServers // {}' "$DEF/mcp.json")"
  jq --argjson s "$servers" '. + {mcpServers: $s}' "$cj" > "$cj.tmp" && mv "$cj.tmp" "$cj"
  # Clear what the previous definition exported, so a removed or emptied
  # setting does not survive into the next buzz-acp.
  unset AGENT_DISPLAY_NAME AGENT_ABOUT BUZZ_ACP_AGENTS BUZZ_ACP_SESSION_POLICY BUZZ_ACP_EFFORT_LEVEL \
        BUZZ_ACP_RESPOND_TO BUZZ_ACP_RESPOND_TO_ALLOWLIST BUZZ_ACP_CHANNELS BUZZ_ACP_MODEL BUZZ_RELAY_URL BUZZ_ACP_AGENT_OWNER \
        BUZZ_ACP_HEARTBEAT_INTERVAL BUZZ_ACP_HEARTBEAT_PROMPT_FILE
  eval "$(definition-env "$DEF/agent.yaml")"
  # An agent with a heartbeat.md in its definition runs it on the interval from
  # agent.yaml (heartbeat_interval, emitted above). No heartbeat.md means no
  # heartbeat, so drop any interval the agent.yaml set. Agents without one (echo)
  # are unaffected.
  if [ -f "$DEF/heartbeat.md" ]; then export BUZZ_ACP_HEARTBEAT_PROMPT_FILE="$DEF/heartbeat.md"
  else unset BUZZ_ACP_HEARTBEAT_PROMPT_FILE BUZZ_ACP_HEARTBEAT_INTERVAL; fi
  if [ -s "$DEF/auth-tag" ]; then export BUZZ_AUTH_TAG="$(tr -d '\n' < "$DEF/auth-tag")"
  elif [ -n "$VAULT_AUTH_TAG" ]; then export BUZZ_AUTH_TAG="$VAULT_AUTH_TAG"
  else unset BUZZ_AUTH_TAG; fi
  # The definition's files/ are reachable from the workspace, as /opt/agent/files is on serrano.
  rm -rf "$AGENT_WORKDIR/definition-files"
  [ -d "$DEF/files" ] && cp -R "$DEF/files" "$AGENT_WORKDIR/definition-files"
  export AGENT_DEF_DIR="$DEF"
  export BUZZ_ACP_SYSTEM_PROMPT_FILE="$DEF/charter.md"
  export BUZZ_ACP_AGENT_COMMAND=${BUZZ_ACP_AGENT_COMMAND:-claude-agent-acp}
  export BUZZ_ACP_AGENT_ARGS=${BUZZ_ACP_AGENT_ARGS:-}
  export BUZZ_ACP_EXIT_AFTER_INACTIVITY=${BUZZ_ACP_EXIT_AFTER_INACTIVITY:-0}
  export BUZZ_ACP_CONTEXT_MESSAGE_LIMIT=${BUZZ_ACP_CONTEXT_MESSAGE_LIMIT:-100}
  export BUZZ_GIT_IDENTITY=user
  git config --global user.name "${AGENT_DISPLAY_NAME:-$AGENT_SLUG} (AI agent)"
  git config --global user.email "${AGENT_GIT_EMAIL:-$AGENT_SLUG@agents.pulpproject.org}"
  export AGENT_DEFINITION_COMMIT="$(current_commit)"
  installed_tree="$(current_tree)"
}

# Publish the profile with the owner tag so a new or rotated identity shows by
# name; without a tag nothing is published (an untagged kind:0 would replace
# the tagged one and Desktop would stop trusting the agent).
publish_profile() {
  [ -n "${BUZZ_AUTH_TAG:-}" ] || { echo "agent-entrypoint: no owner tag; profile not published"; return 0; }
  local cur avatar args
  cur=$(timeout 20 buzz users get 2>/dev/null) || cur=""
  avatar=$(printf '%s' "$cur" | jq -r '.[0] | .picture // .avatar // empty' 2>/dev/null)
  args=(users set-profile --name "$AGENT_DISPLAY_NAME")
  [ -n "${AGENT_ABOUT:-}" ] && args+=(--about "$AGENT_ABOUT")
  [ -n "$avatar" ] && args+=(--avatar "$avatar")
  timeout 20 buzz "${args[@]}" >/dev/null 2>&1 && echo "agent-entrypoint: profile published as $AGENT_DISPLAY_NAME" || echo "agent-entrypoint: profile not published; carrying on"
}

fetch_definition || { echo "agent-entrypoint: could not fetch $AGENT_DEFINITION_REPO@$AGENT_DEFINITION_REF"; exit 1; }
install_definition || exit 1
publish_profile
echo "agent-entrypoint: $AGENT_SLUG on image $AGENT_REVISION, definition commit $AGENT_DEFINITION_COMMIT"

signalled=0; child=""
# The pod's SIGTERM is not passed straight on: buzz-acp gives an in flight turn
# only 30s after SIGTERM and then kills it (block/buzz#8392), so the main loop
# below holds it until the agent is idle (stop_child).
signal_at=""
trap 'signalled=1; [ -n "$signal_at" ] || signal_at=$(date +%s)' TERM INT
cd "$AGENT_WORKDIR"
RESTART_DIR=${AGENT_RESTART_DIR:-$STATE/restart}
# Replay what arrived while stopped. The staff entrypoint already set the floor
# when it runs; on the base image read the marker stop_child leaves.
# The marker is removed only once buzz-acp has started with it (start_acp), so
# a crash before that keeps it for the next boot.
floor_pending=0
if [ -z "${BUZZ_ACP_REPLAY_FLOOR:-}" ] && [ -s "$RESTART_DIR/stopping-at" ]; then
  export BUZZ_ACP_REPLAY_FLOOR="$(cat "$RESTART_DIR/stopping-at")"
  floor_pending=1
fi
# Hold SIGTERM until no Claude Code transcript has been written for STOP_IDLE
# seconds, up to STOP_HOLD, then pass it on. The defaults fit the pod's 300s
# grace: up to 22s of preStop, 230s here, then buzz-acp's own 30s.
STOP_IDLE=${AGENT_STOP_IDLE_SECONDS:-20}
STOP_HOLD=${AGENT_STOP_HOLD_SECONDS:-230}
# buzz-acp's own "turn starting for" / "turn complete for" lines, kept so the
# hold can tell a turn that is quiet mid tool call from one that has ended.
TURN_LOG=$STATE/turns.log
# Start buzz-acp with its output passed through to the pod log as before, and
# its turn lines copied to TURN_LOG. A named pipe, not process substitution:
# the pod has no /dev/fd.
start_acp() {
  local fifo="${TMPDIR:-/tmp}/acp-out.$$"
  : > "$TURN_LOG"
  rm -f "$fifo"; mkfifo "$fifo"
  awk -v tl="$TURN_LOG" '{ print; fflush() }
    /turn (starting|complete|cancelled|refused|hit [a-z_]+) for / { print >> tl; fflush(tl) }' < "$fifo" &
  "$ACP" > "$fifo" 2>&1 & child=$!
  rm -f "$fifo"
  if [ $floor_pending -eq 1 ]; then rm -f "$RESTART_DIR/stopping-at"; floor_pending=0; fi
}
# The hold counts from the pod's SIGTERM, not from when the main loop gets to
# it (a definition fetch can block for minutes), so the whole stop still fits
# inside the pod's grace period.
hold_left() {
  local spent=0
  [ -n "$signal_at" ] && spent=$(( $(date +%s) - signal_at ))
  local left=$(( STOP_HOLD - spent ))
  [ $left -gt 0 ] && echo $left || echo 0
}
stop_child() {
  agent-stop-hold "$CLAUDE_CONFIG_DIR" "$STOP_IDLE" "$(hold_left)" "$TURN_LOG" || true
  # buzz-acp stops reading the relay at SIGTERM, so the next start replays from
  # this moment. Not from the preStop's earlier mark: mentions answered during
  # the hold would be answered twice.
  mkdir -p "$RESTART_DIR" && date +%s > "$RESTART_DIR/stopping-at"
  kill -TERM "$child" 2>/dev/null
}
DRAIN=${AGENT_DRAIN_SECONDS:-300}
# Wait for buzz-acp to finish in flight turns after SIGTERM; force it after DRAIN.
drain_child() {
  local waited=0
  while kill -0 "$child" 2>/dev/null && [ $waited -lt "$DRAIN" ]; do sleep 2; waited=$((waited+2)); done
  kill -0 "$child" 2>/dev/null && { echo "agent-entrypoint: buzz-acp did not stop in ${DRAIN}s; killing"; kill -KILL "$child" 2>/dev/null; }
}
while :; do
  start_acp
  [ $signalled -eq 1 ] && kill -TERM "$child" 2>/dev/null
  # Watch the definition while buzz-acp runs, polling every few seconds so a
  # crash is noticed at once. A changed tree ends this round: buzz-acp gets
  # SIGTERM (it finishes in flight turns), then restarts on the new definition.
  # The pod itself never restarts for a definition change. Only a successful
  # install advances installed_tree, so a failed update is retried next tick.
  restart=0; elapsed=0
  while kill -0 "$child" 2>/dev/null; do
    # "& wait", not a plain foreground command: bash runs the SIGTERM trap only
    # once a foreground command ends, and a definition fetch can take minutes.
    sleep 5 & wait $!; elapsed=$((elapsed+5))
    [ $signalled -eq 1 ] && break
    [ $elapsed -lt "$WATCH_SECONDS" ] && continue
    elapsed=0
    fetch_definition & wait $!; fetched=$?
    [ $signalled -eq 1 ] && break
    [ $fetched -eq 0 ] || continue
    if [ "$(current_tree)" != "$installed_tree" ]; then
      echo "agent-entrypoint: definition changed; restarting buzz-acp"
      # Same hold as a pod stop, so the reload does not cut a turn short, and
      # the restarted buzz-acp replays what arrived during the restart.
      restart=1; agent-stop-hold "$CLAUDE_CONFIG_DIR" "$STOP_IDLE" "$(hold_left)" "$TURN_LOG" || true
      export BUZZ_ACP_REPLAY_FLOOR="$(date +%s)"
      kill -TERM "$child" 2>/dev/null; drain_child; break
    fi
  done
  if [ $signalled -eq 1 ]; then
    kill -0 "$child" 2>/dev/null && stop_child
    # wait returns early when another signal arrives; keep waiting while buzz-acp drains.
    while kill -0 "$child" 2>/dev/null; do wait "$child" 2>/dev/null; done
    exit 0
  fi
  wait "$child" 2>/dev/null; rc=$?
  [ $signalled -eq 1 ] && exit 0
  if [ $restart -eq 1 ]; then
    if install_definition; then publish_profile; else echo "agent-entrypoint: install failed; keeping the old definition and retrying later"; fi
    continue
  fi
  echo "agent-entrypoint: buzz-acp exited $rc"; exit $rc
done
