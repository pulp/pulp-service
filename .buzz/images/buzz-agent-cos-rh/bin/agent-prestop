#!/bin/bash
# preStop hook. Tell the threads this agent was active in over the last hour that
# it is restarting, and record them so the entrypoint can post "Back." when it
# returns. Runs inside the agent container with the container's own buzz key.
# Writes stopping-at first (the replay floor), then announces under a hard 22s
# cap; the pod's termination grace period is 300s.
set -uo pipefail
dir=${AGENT_RESTART_DIR:-/state/restart}
self=${AGENT_PUBKEY:-}

announce() {
  local since msg f rows
  since=$(( $(date +%s) - 3600 ))
  msg="Restarting now. Back in a few minutes; anything sent meanwhile is picked up when I return."
  f="$dir/threads.json"
  # Threads to announce in: my own replies (thread root from the e tag; my own
  # top-level posts never count, so a null root is dropped below), and mentions
  # of me by others (thread root, or the mention itself when it is top level).
  # Newest first, unique by root, at most 10.
  rows=$(
    {
      buzz messages search --author "$self" --since "$since" --limit 50 2>/dev/null \
        | jq -c '.[] | {t:.created_at, ch:((.tags//[])|map(select(.[0]=="h"))|.[0][1]//null), root:(((.tags//[])|map(select(.[0]=="e")))|((map(select(.[3]=="root"))|.[0][1]) // (map(select(.[3]=="reply"))|.[0][1]) // null))}'
      buzz feed get --types mentions --since "$since" --limit 50 2>/dev/null \
        | jq -c --arg self "$self" '.[] | select(.pubkey != $self) | {t:.created_at, ch:((.tags//[])|map(select(.[0]=="h"))|.[0][1]//null), root:(((.tags//[])|map(select(.[0]=="e")))|((map(select(.[3]=="root"))|.[0][1]) // (map(select(.[3]=="reply"))|.[0][1]) // .id))}'
    } 2>/dev/null \
      | jq -c 'select(.ch != null and .root != null)' \
      | jq -s 'sort_by(.t) | reverse | reduce .[] as $x ([]; if any(.[]; .root == $x.root) then . else . + [$x] end) | .[0:10]'
  )
  # New active threads this stop, as {channel,root}; may be empty.
  local new_rows existing merged
  if [ -z "$rows" ] || [ "$rows" = "null" ] || [ "$rows" = "[]" ]; then
    new_rows='[]'
  else
    new_rows=$(printf '%s' "$rows" | jq -c '[.[] | {channel:.ch, root:.root}]')
  fi
  # Merge with any pending record an earlier stop left that restart-back has not
  # cleared yet, unique by channel+root, new ones first, cap 10. Never clobber a
  # pending record: with no new threads this stop we still keep the pending ones
  # so they get their "Back." when the pod returns.
  existing=$(jq -c '.' "$f" 2>/dev/null) || existing='[]'
  case "$existing" in ''|null) existing='[]';; esac
  merged=$(jq -cn --argjson new "$new_rows" --argjson old "$existing" \
    '($new + $old) | reduce .[] as $x ([]; if any(.[]; .channel == $x.channel and .root == $x.root) then . else . + [$x] end) | .[0:10]')
  if [ "$merged" = "[]" ]; then
    printf '[]' > "$f"; echo "no active threads"; return 0
  fi
  # Save before posting, so a crash mid-loop still leaves "Back." work to do; the
  # record carries both the new and the still-pending threads.
  printf '%s' "$merged" > "$f"
  # Announce only in the threads active this stop. Threads carried over from an
  # earlier stop already got their notice then; announcing again would repeat it.
  local row ch root
  while IFS= read -r row; do
    ch=$(printf '%s' "$row" | jq -r '.channel')
    root=$(printf '%s' "$row" | jq -r '.root')
    [ -n "$ch" ] && [ "$ch" != null ] && [ -n "$root" ] && [ "$root" != null ] || continue
    if printf '%s\n' "$msg" | buzz messages send --channel "$ch" --reply-to "$root" --content - >/dev/null 2>&1; then
      echo "restart-notice: stop $root"
    else
      echo "send failed for $root"
    fi
  done < <(printf '%s' "$new_rows" | jq -c '.[]' 2>/dev/null)
}

# Re-exec path, run under the timeout below.
if [ "${1:-}" = "--announce" ]; then announce; exit 0; fi

mkdir -p "$dir" 2>/dev/null || true
date +%s > "$dir/stopping-at" 2>/dev/null || true
[ -n "$self" ] || { echo "agent-prestop: no AGENT_PUBKEY, skip announce" >&2; exit 0; }
# The kubelet spawns this hook fresh, so it does not have agent-entrypoint's key,
# relay or tag. The definition is still present at shutdown: pull them in (and let
# the re-exec below inherit them) so the announce sends actually reach the relay.
. /usr/local/bin/agent-runtime-env
_agent_runtime_env || { echo "agent-prestop: no runtime env, recorded stop only, skip announce" >&2; exit 0; }
timeout 22 "$0" --announce 2>&1 | sed 's/^/agent-prestop: /' >&2
exit 0
