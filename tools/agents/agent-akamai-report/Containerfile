# Build from tools/agents (agent-akamai-report depends on the local ./shared module):
#   podman build -f agent-akamai-report/Containerfile -t agent-akamai-report .
FROM registry.access.redhat.com/ubi9/go-toolset:9.9-1794518352 AS builder

WORKDIR /opt/app-root/src

COPY shared/go.mod shared/go.sum shared/
COPY agent-akamai-report/go.mod agent-akamai-report/go.sum agent-akamai-report/
# Minimal workspace so the build uses ./shared instead of the version pinned in go.mod.
RUN go work init ./shared ./agent-akamai-report && cd agent-akamai-report && go mod download

COPY shared/ shared/
COPY agent-akamai-report/ agent-akamai-report/
# Write to WORKDIR (owned by the build user); COPY-ed sources are root-owned.
RUN cd agent-akamai-report && CGO_ENABLED=0 go build -buildvcs=false -o ../agent-akamai-report.bin .

# Runtime stage
FROM registry.access.redhat.com/ubi9-minimal:latest

WORKDIR /app

COPY --from=builder /opt/app-root/src/agent-akamai-report.bin ./agent-akamai-report

USER 1001

ENTRYPOINT ["./agent-akamai-report"]
