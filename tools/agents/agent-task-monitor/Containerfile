# Build from tools/agents (agent-task-monitor depends on the local ./shared module):
#   podman build -f agent-task-monitor/Containerfile -t agent-task-monitor .
FROM registry.access.redhat.com/ubi9/go-toolset:9.9-1795320499 AS builder

WORKDIR /opt/app-root/src

COPY shared/go.mod shared/go.sum shared/
COPY agent-task-monitor/go.mod agent-task-monitor/go.sum agent-task-monitor/
# Minimal workspace so the build uses ./shared instead of the version pinned in go.mod.
RUN go work init ./shared ./agent-task-monitor && cd agent-task-monitor && go mod download

COPY shared/ shared/
COPY agent-task-monitor/ agent-task-monitor/
# Write to WORKDIR (owned by the build user); COPY-ed sources are root-owned.
RUN cd agent-task-monitor && CGO_ENABLED=0 go build -buildvcs=false -o ../agent-task-monitor.bin .

# Runtime stage
FROM registry.access.redhat.com/ubi9-minimal:latest

WORKDIR /app

COPY --from=builder /opt/app-root/src/agent-task-monitor.bin ./agent-task-monitor

USER 1001

ENTRYPOINT ["./agent-task-monitor"]
